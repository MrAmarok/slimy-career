# Copier ce fichier en « .env » et remplir les valeurs. Le fichier .env n'est jamais versionné.

# Mot de passe de la base PostgreSQL (une longue chaîne aléatoire : `openssl rand -hex 24`)
POSTGRES_PASSWORD=

# Premier compte (administrateur), créé au premier démarrage. Les autres comptes se créent dans « Mon compte ».
APP_ADMIN_USERNAME=admin
APP_ADMIN_PASSWORD=

# Jeton du tunnel Cloudflare (Zero Trust > Networks > Tunnels > créer un tunnel > « Docker » : la valeur après --token)
CLOUDFLARE_TUNNEL_TOKEN=

# Clé de chiffrement des secrets rangés en base (double authentification, clés d'API) : `openssl rand -hex 32`
# À ne jamais changer ni perdre : sans elle, les doubles authentifications et clés d'API enregistrées deviennent illisibles.
APP_SECRET_KEY=

# Google Jobs : clé SerpAPI commune à tous les comptes (https://serpapi.com), facultative. Sans clé, Google est ignoré.
SERPAPI_KEY=

# Port local de l'application et fuseau horaire
APP_PORT=8080
TZ=Europe/Paris
